<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText android:id="@+id/editName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Display name (e.g. Server 1 - NY)" />
        <EditText android:id="@+id/editCountryName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Country name (e.g. United States)" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editCountryCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Country code, 2 letters (e.g. US)" android:layout_marginTop="8dp" android:maxLength="2" />
        <EditText android:id="@+id/editCity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="City (optional)" android:layout_marginTop="8dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray" android:layout_marginVertical="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WireGuard connection details (from your VPS)" android:textStyle="bold" />

        <EditText android:id="@+id/editHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="VPS IP address" android:layout_marginTop="8dp" android:inputType="textUri" />
        <EditText android:id="@+id/editPort" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="WireGuard port (default 51820)" android:layout_marginTop="8dp" android:inputType="number" android:text="51820" />
        <EditText android:id="@+id/editPublicKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Server public key (from: wg show wg0 public-key)" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editPresharedKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Preshared key (optional)" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editClientAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Client subnet (must match setup-wireguard.sh, usually 10.8.0.0/24)" android:layout_marginTop="8dp" android:text="10.8.0.0/24" />
        <EditText android:id="@+id/editDns" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="DNS" android:layout_marginTop="8dp" android:text="1.1.1.1" />

        <Button android:id="@+id/buttonSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save server" android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
