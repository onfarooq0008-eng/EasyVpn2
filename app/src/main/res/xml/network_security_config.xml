<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds block plain HTTP everywhere by default (Android's standard
     behavior since API 28) except the one domain/IP explicitly listed below;
     your brain VPS, so the app keeps working while you're setting up HTTPS.
     REMOVE this domain-config once you've put HTTPS in front of your brain
     VPS (see backend/README.md section 4); at that point this whole file
     can be deleted and the manifest reference to it removed too. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">51.170.85.90</domain>
    </domain-config>
</network-security-config>
